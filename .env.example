# Configuración del servidor y entorno
PORT=3000
NODE_ENV=development

# Base de datos (SQLite en desarrollo, PostgreSQL o SQLite en Render)
DATABASE_URL="file:./dev.db"

# Seguridad y Autenticación JWT (Variable sensible, configurar en el panel de Render)
JWT_SECRET="reemplazar_con_clave_secreta_segura_para_jwt_en_produccion"

# Dominios autorizados para CORS (separados por coma)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://repar-tir.com"
