meta {
  name: 6. Transicion Invalida 2 - ELIMINADA a CONFIRMADA (400)
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/lists/{{listId}}/status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "status": "CONFIRMADA"
  }
}

tests {
  test("Debe rechazar con 400 Bad Request la transición inválida ELIMINADA -> CONFIRMADA", function() {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  # Escenario 6: Transición Inválida 2 — `ELIMINADA -> CONFIRMADA` (400 Bad Request)
  Verifica que una lista en estado terminal `ELIMINADA` no pueda pasar al estado `CONFIRMADA`, devolviendo **400 Bad Request**.
}
